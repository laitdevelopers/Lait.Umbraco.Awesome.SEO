{
  "name": "Awesome SEO for Umbraco",
  "version": "1.1.0",
  "allowPackageTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "lait.dashboard.seo",
      "name": "Awesome SEO for Umbraco dashboard",
      "author": "LAIT, Anders Bootsmann Overvad",
      "js": "/App_Plugins/LaitSeoReport/seo-dashboard.js?v=1.1.0.2",
      "elementName": "lait-seo-dashboard",
      "weight": 14,
      "meta": {
        "label": "SEO",
        "pathname": "seo"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "lait.seo.copilotBridge",
      "name": "Awesome SEO for Umbraco: Copilot bridge",
      "js": "/App_Plugins/LaitSeoReport/seo-copilot.js?v=1.1.0.2"
    }
  ]
}
